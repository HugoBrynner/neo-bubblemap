FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY backend/package*.json ./backend/
COPY package*.json ./

# Install dependencies
RUN npm install --workspace=backend

# Copy backend source
COPY backend ./backend

# Build backend
WORKDIR /app/backend
RUN npm run build

# Expose port
EXPOSE 3001

# Start the backend
CMD ["npm", "start"]
